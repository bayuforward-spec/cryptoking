{
  "name": "CryptoKing",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt && (test -f .env || cp .env.example .env)",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "CryptoKing dashboard",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
