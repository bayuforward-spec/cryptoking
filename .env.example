# ============================================================
# CryptoKing — environment configuration
# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file (it is git-ignored).
# ============================================================

# --- Crypto.com Exchange API keys (only needed for LIVE mode) ---
# Create at: https://crypto.com/exchange -> Settings -> API Keys
# IMPORTANT: enable TRADING permission, DISABLE withdraw, restrict by IP.
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=

# --- Trading mode ---
# paper = simulation with real live prices, no real money (DEFAULT, SAFE)
# live  = real orders with real money (requires API keys above)
MODE=paper

# Optional override of the API base URL (leave blank for default)
CRYPTOCOM_API_BASE=
